# Kopie nach .env (lokal für die Entwicklung, im Betrieb für docker compose).

# Passwort für /admin und /host. Pflicht.
ADMIN_PASSWORD=change-me

# Geheimer Schlüssel für die Pseudonymisierung (HMAC). Pflicht, mindestens 16 Zeichen.
# Erzeugen: openssl rand -hex 32   (oder: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Nach dem ersten Start nicht mehr ändern: sonst passen bestehende Einreichungen nicht mehr zu den Personen.
PRIBE_SECRET=replace-with-a-long-random-string

# Öffentliche Adresse (Basis für den QR-Code; https:// schaltet Secure-Cookies ein). Pflicht.
# Im Betrieb z. B. https://pribe.example.org
PUBLIC_URL=http://localhost:5173

# Port des Servers. Im Container ist er fest 3000 (docker-compose.yml);
# der Port nach außen ist HOST_PORT.
PORT=3000

# Nur Docker: Port auf dem Host (nur 127.0.0.1), Standard 4109.
# HOST_PORT=4109

# Größtes erlaubtes Upload-Limit in MB. Ein Reverse Proxy muss mindestens das erlauben.
MAX_UPLOAD_MB=100

# SQLite-Datei und hochgeladene Dateien. Relative Pfade gelten ab dem Repo-Root;
# im Container ist es fest /data (Volume).
DATA_DIR=./data

# Log-Stufe: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=info

# Nur Entwicklung: Vite-Port (Proxy auf /api und /socket.io zu PORT).
WEB_DEV_PORT=5173
